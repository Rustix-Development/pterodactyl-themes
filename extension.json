{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "themes",
    "type": "theme",
    "name": "Theme Studio",
    "version": "1.0.0",
    "description": "A free theme for the whole panel: dark and light, ten built-in presets, presets of your own, and scheduled seasonal themes like Halloween and Christmas with their effects.",
    "author": "RustixDev",
    "icon": "palette",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": ">=2.0.0-beta.6 <3.0",
        "php": "^8.3"
    },
    "provider": "RustixDev\\Themes\\ThemesProvider",
    "ui": {
        "entry": "dist/client.js",
        "screens": [
            {
                "id": "admin",
                "area": "admin",
                "path": "theme-studio",
                "nav": {
                    "label": "Theme Studio",
                    "icon": "palette"
                }
            }
        ]
    },
    "theme": {
        "stylesheet": "dist/theme.css",
        "schemes": [
            "dark",
            "light"
        ],
        "settings": {
            "effects": {
                "type": "select",
                "label": "Effects",
                "help": "How much of a preset's effect shows: the bats of Halloween, the snow of Christmas, falling leaves or confetti. Never shown to people who turn off animations on their device. Presets and their schedules are under Admin > Theme Studio.",
                "options": {
                    "off": "Off",
                    "subtle": "Subtle",
                    "full": "Full"
                },
                "default": "subtle",
                "attribute": "data-ts-effects"
            },
            "font": {
                "type": "select",
                "label": "Font",
                "tab": "Look",
                "options": {
                    "panel": "IBM Plex Sans (the panel's)",
                    "inter": "Inter",
                    "system": "The device's own",
                    "mono": "JetBrains Mono"
                },
                "default": "panel",
                "attribute": "data-ts-font"
            },
            "radius": {
                "type": "number",
                "label": "Corner radius",
                "help": "0 for square corners.",
                "tab": "Look",
                "default": 0.5,
                "min": 0,
                "max": 1.25,
                "step": 0.125,
                "unit": "rem",
                "token": "--radius"
            },
            "density": {
                "type": "select",
                "label": "Density",
                "tab": "Look",
                "options": {
                    "comfortable": "Comfortable",
                    "compact": "Compact"
                },
                "default": "comfortable",
                "attribute": "data-ts-density"
            },
            "logo": {
                "type": "image",
                "label": "Logo",
                "help": "Shown in place of the panel's name in the header and on the sign-in page.",
                "tab": "Look",
                "token": "--brand-logo"
            }
        }
    }
}
